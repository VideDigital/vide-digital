// Regras de segurança do Firebase Storage versionadas no repositório.
// Qualquer mudança deve ser validada no Emulator e publicada somente pelo
// fluxo manual autorizado; este arquivo não comprova o estado do deploy.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return signedIn()
        && request.auth.uid == ownerUid
        && ownerApprovedForAccess(ownerUid);
    }

    function ownerApprovedForAccess(ownerUid) {
      return firestore.exists(/databases/(default)/documents/usuarios/$(ownerUid))
        && ownerApprovedData(firestore.get(/databases/(default)/documents/usuarios/$(ownerUid)).data);
    }

    function ownerApprovedData(ownerData) {
      return ownerData.keys().hasAll(["status"])
        && ownerData.status == "aprovado";
    }

    // Contrato futuro: claim emitida por Cloud Functions/Admin SDK.
    function isBackendAdmin() {
      return signedIn()
        && request.auth.token.keys().hasAny(["videAdmin"])
        && request.auth.token.videAdmin == true;
    }

    function employeeDoc() {
      return firestore.get(/databases/(default)/documents/funcionarios/$(request.auth.uid));
    }

    // Recebe empData já buscado em vez de chamar employeeDoc() (um
    // firestore.get()) de novo a cada campo acessado — mesmo ajuste feito em
    // firestore.rules, que reduziu de até 10 chamadas repetidas ao mesmo
    // documento para 1 por avaliação de canUpload.
    function isActiveEmployeeForData(ownerUid, empData) {
      return empData.keys().hasAll(["status", "donoUID", "permissoes"])
        && empData.status == "ativo"
        // Legado sem flag permanece compatível; valores malformados negam.
        && (!empData.keys().hasAny(["authSyncPendente"]) || empData.authSyncPendente == false)
        && empData.donoUID is string
        && empData.donoUID == ownerUid
        && empData.permissoes is map
        && empData.permissoes.keys().hasAll(["editar"])
        && empData.permissoes.editar is list;
    }

    function isActiveEmployeeFor(ownerUid) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/funcionarios/$(request.auth.uid))
        && isActiveEmployeeForData(ownerUid, employeeDoc().data);
    }

    function employeeCanUpload(ownerUid, moduleKey) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/funcionarios/$(request.auth.uid))
        && employeeCanUploadData(ownerUid, moduleKey, employeeDoc().data);
    }

    function employeeCanUploadData(ownerUid, moduleKey, empData) {
      return isActiveEmployeeForData(ownerUid, empData)
        && empData.permissoes.editar.hasAny([moduleKey]);
    }

    function canUpload(ownerUid, moduleKey) {
      // No máximo dois documentos distintos: owner do caminho e funcionário.
      // O ramo owner não consulta funcionarios; admin não depende dos docs.
      return isBackendAdmin()
        || (signedIn()
          && ownerApprovedForAccess(ownerUid)
          && (request.auth.uid == ownerUid || employeeCanUpload(ownerUid, moduleKey)));
    }

    function validImage(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches("image/(jpeg|png|webp|gif)");
    }

    function validDigitalFile() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType.matches("application/pdf");
    }

    // Paths futuros. O frontend atual usa majoritariamente base64 no Firestore.
    match /stores/{ownerUid}/products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if canUpload(ownerUid, "produtos") && validImage(5 * 1024 * 1024);
      allow delete: if canUpload(ownerUid, "produtos");
    }

    match /stores/{ownerUid}/profile/{fileName} {
      allow read: if true;
      allow create, update: if canUpload(ownerUid, "configuracoes") && validImage(2 * 1024 * 1024);
      allow delete: if canUpload(ownerUid, "configuracoes");
    }

    match /stores/{ownerUid}/banners/{fileName} {
      allow read: if true;
      allow create, update: if canUpload(ownerUid, "configuracoes") && validImage(6 * 1024 * 1024);
      allow delete: if canUpload(ownerUid, "configuracoes");
    }

    match /stores/{ownerUid}/landing-pages/{pageId}/{fileName} {
      allow read: if true;
      allow create, update: if canUpload(ownerUid, "landing-pages") && validImage(5 * 1024 * 1024);
      allow delete: if canUpload(ownerUid, "landing-pages");
    }

    match /stores/{ownerUid}/digital-products/{productId}/{fileName} {
      // Fase futura: leitura deve validar comprador/licença antes de produção.
      allow read: if isBackendAdmin() || isOwner(ownerUid);
      allow create, update: if canUpload(ownerUid, "produtos") && validDigitalFile();
      allow delete: if canUpload(ownerUid, "produtos");
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
